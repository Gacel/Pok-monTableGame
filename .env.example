# .env.example — SOLO variables NO sensibles o punteros a Vault.
# Copia a `.env` (git-ignored). Las credenciales REALES van a HashiCorp Vault (C1.1),
# nunca aquí.
#
# `.env` es OBLIGATORIO: game-service lo declara en `env_file`, así que compose
# aborta con «Couldn't find env file» antes de arrancar nada si falta.
#
# Si editas este fichero en Windows, guárdalo con saltos de línea LF. Con CRLF, el
# `\r` acaba DENTRO del valor y cosas como COOKIE_SECURE=false dejan de ser
# iguales a "false". (`dev.sh` lo normaliza al arrancar, por si acaso.)

# --- General ---
NODE_ENV=development
LOG_LEVEL=info
TZ=Europe/Madrid

# --- Puertos publicados en el HOST ----------------------------------------
# Solo cambian la cara externa: dentro de los contenedores los puertos siguen
# siendo 3000 / 3001 / 5173 / 80 / 443.
#
# Los defaults NO son los canónicos, a propósito:
#   - podman rootless no puede bindear puertos <1024 (ver docs/02-LOCAL_DEV.md §12)
#   - en algunos hosts 3000/3001 ya están ocupados por otros servicios
#
# Para servir en 80/443 (producción), pon HOST_GATEWAY_HTTP=80 y
# HOST_GATEWAY_HTTPS=443. Con Docker normal funciona directamente; en podman
# rootless hace falta bajar antes `ip_unprivileged_port_start`.
HOST_GATEWAY_HTTP=8080
HOST_GATEWAY_HTTPS=8443
HOST_HELLO=13000
HOST_GAME=13001
HOST_FRONTEND=15173

# --- Vault (C1.1) — token raíz SOLO para modo dev local ---
# (no es un secreto real de producción; Vault dev lo regenera en cada arranque
#  salvo que se fije este token de desarrollo)
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN=dev-only-root-token

# --- Infra (se activan en Fase 2/3) ---
RABBITMQ_URL=amqp://rabbitmq:5672
REDIS_URL=redis://redis:6379

# --- Punteros a secretos en Vault (las claves se leen en runtime) ---
# JWT_SECRET_PATH=secret/transcendence/jwt
# GOOGLE_OAUTH_PATH=secret/transcendence/google_oauth
# SMTP_PATH=secret/transcendence/smtp

# --- Credenciales temporales para Dev Local (hasta usar Vault) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública del frontend (la usan los redirects de OAuth). En local con los
# puertos por defecto: https://localhost:8443
FRONTEND_URL=https://poke.42transcendence.com

# --- JWT de sesión ---
# Secreto para firmar los JWT (mín. 16 caracteres). El arranque ABORTA si falta.
# SOLO dev: en producción va a Vault (C1.1), nunca un secreto real aquí.
# Genera uno propio:  openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# --- Cookie de sesión ---
# La sesión viaja en una cookie HttpOnly. `Secure` se activa por defecto (HTTPS).
# Ponlo a false SOLO si accedes por http directo sin gateway (p.ej. localhost:15173).
# Sirviendo público por HTTPS debe ser true.
COOKIE_SECURE=true

# --- Login de PRUEBAS (⚠️ PUERTA TRASERA) ---
# Con true, permite entrar con admin@42transcendence.com / 42transcendence SIN
# registro (la cuenta se crea al primer login). SOLO testeo; DESACTIVAR en prod.
ALLOW_TEST_LOGIN=false

# --- Certificado Let's Encrypt (lo usa `./dev.sh cert`) --------------------
# Ver docs/02-LOCAL_DEV.md §13. En local NO hace falta nada de esto: el gateway
# genera un self-signed al arrancar si no encuentra certificado.
#
# CERT_NAME es el nombre del directorio bajo /etc/letsencrypt/live/, que es la
# ruta cableada en gateway/nginx.conf. Puede diferir del primer dominio: eso
# permite emitir para un subdominio sin tocar la config de nginx.
CERT_NAME=42transcendence.com
# Dominios del certificado, separados por espacios y ENTRE COMILLAS (sin ellas,
# al hacer `source` del fichero solo se asignaría el primero). Todos deben
# resolver a la IP pública de este host.
CERT_DOMAINS="poke.42transcendence.com www.poke.42transcendence.com 42transcendence.com www.42transcendence.com"
# Obligatorio para emitir: Let's Encrypt lo exige para los avisos de caducidad.
CERT_EMAIL=
